# ====================================
# PLANTILLA DE VARIABLES DE ENTORNO
# ====================================
# Copia este archivo como .env y configura los valores reales
# NUNCA subas el archivo .env al repositorio

# ====================================
# ENTORNO DE LA APLICACIÓN
# ====================================
NODE_ENV=development
PORT=3000

# ====================================
# CONFIGURACIÓN DE BASE DE DATOS
# ====================================
# Tipo de BD: mysql o postgres (configura en database.module.ts)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=tu_usuario
DB_PASSWORD=tu_contraseña_segura
DB_NAME=tu_base_de_datos

# Opciones de desarrollo (¡NUNCA uses synchronize=true en producción!)
DB_SYNC=false
DB_LOGGING=false

# ====================================
# CONFIGURACIÓN DE JWT
# ====================================
# IMPORTANTE: Genera secrets seguros con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=GENERA_UN_SECRET_SEGURO_DE_AL_MENOS_32_CARACTERES
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=GENERA_OTRO_SECRET_DIFERENTE_PARA_REFRESH
JWT_REFRESH_EXPIRES_IN=7d

# ====================================
# CONFIGURACIÓN DE CORS
# ====================================
# URLs permitidas separadas por comas
CORS_ORIGINS=http://localhost:3000,http://localhost:4200
CORS_CREDENTIALS=true

# ====================================
# RATE LIMITING
# ====================================
THROTTLE_TTL=60
THROTTLE_LIMIT=10
